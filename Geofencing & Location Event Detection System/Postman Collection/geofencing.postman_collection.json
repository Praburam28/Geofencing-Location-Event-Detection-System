            },
            "url": "{{base_url}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registered or already exists', function () { pm.expect([201,400]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
